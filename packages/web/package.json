{
  "name": "@template/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/api/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json && vite build --config vite.cloudflare.config.ts",
    "dev": "vite",
    "start": "bun src/__server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && oxlint packages/web --deny-warnings --no-error-on-unmatched-pattern",
    "preview": "bun run build && vite preview",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "@libsql/client": "^0.17.4",
    "@orpc/client": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@orpc/tanstack-query": "^1.16.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "lucide-react": "^0.577.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.9",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
